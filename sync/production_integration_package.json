    "3. Run deployment script: bash automation/deploy.sh",
    "4. Configure GitHub token in environment variables",
    "5. Start WILLOW sync service: sudo systemctl start willow-sync",
    "6. Verify operational status: systemctl status willow-sync"
  ],
  "production_requirements": {
