{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Registration Schema",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "agent_type": {
      "type": "string",
      "enum": [
        "willow",
        "claude",
        "gpt",
        "custom"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "agent_id",
    "agent_type",
    "capabilities"
  ]
}